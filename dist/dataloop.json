{
    "id": "2",
    "version": "1.0.65",
    "creator": "adva.a@dataloop.ai",
    "name": "reference-viewer",
    "displayName": "Reference Viewer",
    "description": "",
    "icon": "icon-dl-sdk-documentation",
    "categories": ["referenceViewer"],
    "codebase": {
        "type": "git",
        "gitUrl": "https://github.com/dataloop-ai-apps/reference-viewer.git",
        "gitTag": "1.0.65"
    },
    "scope": "public",
    "components": {
        "panels": [
            {
                "name": "referenceViewer",
                "minRole": "annotator",
                "supportedSlots": [
                    {
                        "type": "floatingWindow",
                        "configuration": {
                            "layout": {
                                "width": 455,
                                "height": 340,
                                "resizable": true,
                                "backgroundColor": "dl-color-studio-panel",
                                "position": {
                                    "x": 775,
                                    "y": 55
                                }
                            },
                            "route": ["datasetItem"]
                        }
                    }
                ],
                "icon": "icon-dl-sdk-documentation",
                "metadata": {},
                "defaultSettings": {},
                "conditions": {
                    "resources": [
                        {
                            "entityType": "item",
                            "filter": {
                                "$and": [
                                    {
                                        "metadata.system.modalities.type": "preview"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ],
        "toolbars": [],
        "modules": [],
        "services": [
            {
                "name": "dataloop-reference-viewer-runner",
                "panelNames": ["referenceViewer"],
                "initParams": {},
                "packageName": "default-package",
                "packageRevision": "latest",
                "versions": {"dtlpy": "latest"},
                "runtime": {
                    "podType": "regular-xs",
                    "numReplicas": 1,
                    "concurrency": 10,
                    "runnerImage": "hub.dataloop.ai/customerhub/piper/agent/runner/cpu/base:python3.13_full_bci",
                    "singleAgent": false,
                    "autoscaler": {
                        "type": "rabbitmq",
                        "minReplicas": 1,
                        "maxReplicas": 2,
                        "queueLength": 10
                    },
                    "preemptible": false,
                    "executionTimeout": 3600
                }
            }
        ],
        "triggers": [],
        "pipelines": [],
        "models": [],
        "snapshots": []
    },
    "trusted": true
}
